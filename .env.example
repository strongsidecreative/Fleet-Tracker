# From Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_, never expose to the browser.
# Used only inside app/api/** routes (e.g. creating driver accounts).
SUPABASE_SERVICE_ROLE_KEY=

# Push notifications. Generate a keypair once with:
#   npx web-push generate-vapid-keys
# The public key is safe to expose to the browser (NEXT_PUBLIC_); the
# private key is a secret, same rules as the service role key above.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any mailto: or https: URL — required by the push spec, used by browsers'
# push services to contact you if they need to (e.g. sending too much push).
VAPID_SUBJECT=mailto:you@example.com

# A random secret shared with the Supabase database trigger that calls
# /api/push/dispatch. Generate with: openssl rand -hex 32
# Must match the 'push_dispatch_secret' row in the app_config table
# (see supabase/migrations/0012_push_notifications.sql).
PUSH_DISPATCH_SECRET=
